name: Update AI News
on:
  schedule:
    - cron: '0 * * * *' # Runs every hour
  workflow_dispatch: # Allows you to run it manually

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repo
        uses: actions/checkout@v3

      - name: Fetch News
        run: |
          curl "https://newsapi.org/v2/everything?q=artificial%20intelligence&sortBy=publishedAt&language=en&apiKey=${{ secrets.NEWS_API_KEY }}" > ai-news.json

      - name: Commit and Push
        run: |
          git config --global user.name "GitHub Action"
          git config --global user.email "action@github.com"
          git add ai-news.json
          git commit -m "Update AI News Feed" || exit 0
          git push
